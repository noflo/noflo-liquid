{
  "name": "@noflo/liquid",
  "description": "Liquid template engine components for NoFlo",
  "version": "2.0.0-alpha.4",
  "author": {
    "name": "Henri Bergius",
    "email": "henri.bergius@iki.fi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noflo/noflo-liquid.git"
  },
  "license": "MIT",
  "dependencies": {
    "@noflo/noflo": "^2.0.0-alpha.3",
    "he": "^1.2.0",
    "liquidjs": "^10.30.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@noflo/fbp-spec-runner": "^2.0.0-alpha.3",
    "@noflo/loader-node": "^2.0.0-alpha.3",
    "@types/he": "^1.2.3",
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "noflo"
  ],
  "scripts": {
    "lint": "npx @biomejs/biome check --use-editorconfig=true components/ filter/ tags/ test/",
    "format": "npx @biomejs/biome check --use-editorconfig=true --write components/ filter/ tags/ test/",
    "types": "tsc -p tsconfig.json",
    "test": "npm run types && npm run lint && npm run test:node",
    "test:node": "node --test test/*.test.js",
    "test:bun": "bun test test/*.test.js",
    "test:deno": "deno test --allow-all --no-check test/*.test.js",
    "manifest": "npx @noflo/manifest generate ."
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "components/",
    "filter/",
    "tags/",
    "test/",
    "noflo.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
